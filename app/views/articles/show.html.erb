<h1><%= @article.title %></h1>

<p><%= @article.body %></p>

<% if current_user && current_user.id == @article.author.id %>
  <ul>
    <li><%= link_to "Edit", edit_article_path(@article) %></li>
    <li><%= link_to "Destroy", article_path(@article), data: {
      turbo_method: :delete,
      turbo_confirm: "Are you sure?"
    } %></li>
  </ul>
<% end %>

<section>
  <h2>Comments</h2>
  <%= render @article.comments %>
</section>

<% if current_user %>
  <hr>
  <section>
    <h3>Leave a comment as <%= current_user.email %>:</h3>
    <%= render "comments/form", article: @article %>
  </section>
<% end %>
